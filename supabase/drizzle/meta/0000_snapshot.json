      "isExisting": false,
      "definition": "SELECT t.id AS tenant_id, (COALESCE(b.name, '?'::text) || '-'::text) || COALESCE(u.flat, '?'::text) AS username, t.phone AS default_password, t.must_change_password AS using_default_password, t.name AS tenant_name, b.name AS building, u.wing, u.flat, t.email, t.active FROM tenants t LEFT JOIN units u ON u.id = t.unit_id LEFT JOIN buildings b ON b.id = u.building_id ORDER BY b.name, u.flat",

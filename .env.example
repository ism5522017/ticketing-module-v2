# Copy to .env.local and fill in real values.
# .env.local is gitignored.

# ===== Supabase =====
# Find these in the Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — server-only, bypasses RLS.
# Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Storage bucket (must already exist — same as old app)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=ticket-attachments

# ===== Database (Drizzle) =====
# Settings → Database → Connection string → URI (Transaction pooler, port 6543)
# Or for direct connection (port 5432) for migrations: use Session pooler URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-X-region.pooler.supabase.com:5432/postgres

# ===== Onboarding tokens =====
# Used to sign short-lived JWTs that gate /onboarding/set-password and carry
# the email between Continue and Sign-In steps. Any random 32+ byte string.
# Generate with: openssl rand -base64 48
ONBOARDING_TOKEN_SECRET=replace-with-a-random-string
